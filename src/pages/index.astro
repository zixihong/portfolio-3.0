---
import Layout from '../layouts/Layout.astro'
import { AsciiTree } from '../components/AsciiTree'
import { readFileSync, existsSync } from 'fs'
import { resolve } from 'path'
import { buildRegionMap, type AsciiConfig } from 'inklet'
import { figContents } from '../data/projects'

const jsonPath = resolve(process.cwd(), 'src/data/ascii-tree.json')

let asciiData
const paintedPath = resolve(process.cwd(), 'src/data/ascii-config.json')
if (existsSync(paintedPath)) {
  const config: AsciiConfig = JSON.parse(readFileSync(paintedPath, 'utf-8'))
  const regionConfig = {
    regions: config.regionConfig.regions.map(region => {
      const fig = figContents.find(fig => fig.label.toLowerCase() === region.label?.trim().toLowerCase())
      if (!fig) throw new Error(`Unknown fig region "${region.label}". Use: ${figContents.map(fig => fig.label).join(', ')}`)
      return { ...region, id: fig.id }
    }),
  }
  asciiData = {
    cols: config.data.cols,
    rows: config.data.rows,
    chars: config.data.chars,
    colors: config.data.colorIndices.map(index => config.data.palette[index]),
    regions: buildRegionMap(config.data, regionConfig).regionMap,
  }
} else if (existsSync(jsonPath)) {
  asciiData = JSON.parse(readFileSync(jsonPath, 'utf-8'))
} else {
  // Placeholder when no image has been processed yet
  const cols = 60
  const rows = 20
  const chars = Array(rows).fill(null).map((_, r) => {
    return Array(cols).fill(null).map((_, c) => {
      const cx = cols / 2, cy = rows * 0.4
      const dx = (c - cx) / (cols * 0.3), dy = (r - cy) / (rows * 0.5)
      const d = Math.sqrt(dx * dx + dy * dy)
      if (r > rows * 0.7 && Math.abs(c - cx) < 2) return '#'
      if (d < 0.7) return ['@', '%', '#', '*', '+'][Math.floor(Math.random() * 5)]
      return ' '
    }).join('')
  }).join('')
  asciiData = {
    cols,
    rows,
    chars,
    colors: Array(cols * rows).fill('#4ade80'),
    regions: Array(cols * rows).fill(null),
  }
}
---

<Layout title="bh">
  <main class="relative overflow-hidden h-screen fixed inset-0">
    <AsciiTree client:load data={asciiData} />
  </main>
</Layout>
